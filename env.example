# --- OpenAI / Agents SDK ---
OPENAI_API_KEY=

# --- Model selection ---
# Cheap/fast model for triage classification
TRIAGE_MODEL=gpt-4o-mini
# Larger model for drafting + conversational SDR agent
AGENT_MODEL=gpt-4o

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=       # e.g. +15555550123
# Optional: use a Messaging Service SID instead of a single from-number for
# bulk sends. Leave completely empty (not just blank) if unused.
TWILIO_MESSAGING_SERVICE_SID=

# --- Supabase ---
# From: Project Settings > API Keys > "Publishable and secret API keys" tab
SUPABASE_URL=
SUPABASE_SECRET_KEY=   # sb_secret_... — server-side only, bypasses RLS, never expose client-side

# --- App ---
APP_BASE_URL=             # public URL Twilio will webhook to, e.g. https://yourapp.up.railway.app
PUSHOVER_USER=            # optional, for human-handoff notifications
PUSHOVER_TOKEN=           # optional
# Set this to unlock instant real-send on the /demo page (bypasses the
# review queue) - only you should know this. Leave empty to disable the
# instant-send path entirely; the review-queue path still works either way.
DEMO_ADMIN_PASSWORD=
